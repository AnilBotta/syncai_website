# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code (machine-local overrides only)
.claude/settings.local.json

# Hero-tour working files. The per-beat clips are masters kept only for
# re-cutting, and test-* are local staging copies — the tour ships the joined
# master from Cloudinary (see components/home/tour-media.ts), so none of these
# belong in the repo or the deploy.
/public/brand/beat*.mp4
/public/brand/test-*

# Demo-site photography. Delivery is from Cloudinary (see lib/demo-sites/dental.ts),
# so neither the full-resolution masters in /public/brand nor the resized 2000px
# copies in /public/demos belong in the repo or the deploy. Both are kept locally
# for re-cropping and re-uploading — same arrangement as the hero-tour masters.
/public/brand/hero.jpeg
/public/brand/treatment.jpeg
/public/brand/practice team.jpeg
/public/brand/detail.jpeg
/public/brand/exterior.jpeg
/public/brand/realestate/
/public/brand/Physio/
/public/brand/trade/
/public/demos/

# typescript
*.tsbuildinfo
next-env.d.ts
