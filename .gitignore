# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code (machine-local overrides only)
.claude/settings.local.json

# Hero-tour working files. The per-beat clips are masters kept only for
# re-cutting, and test-* are local staging copies — the tour ships the joined
# master from Cloudinary (see components/home/tour-media.ts), so none of these
# belong in the repo or the deploy.
/public/brand/beat*.mp4
/public/brand/test-*

# typescript
*.tsbuildinfo
next-env.d.ts
