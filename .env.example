# Supabase (leads + appointments persistence, admin dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=

# OpenAI (demo analyzer, chatbot, voice bot)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Cloudflare Turnstile (bot protection on the lead + booking forms).
# Leave both blank to disable verification (forms still work in dev/demo).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (outbound email from the admin Approval Inbox).
# Leave RESEND_API_KEY blank to keep email in demo mode (drafts queue, nothing sends).
RESEND_API_KEY=
# Must use a verified Resend domain, e.g. "Anil at SyncAI <anil@mail.syncaitechnologies.com>"
RESEND_FROM_EMAIL=
EMAIL_REPLY_TO=
# Random secret used to sign one-click unsubscribe links (any long random string).
UNSUBSCRIBE_SECRET=
# Public site URL, used to build unsubscribe links, e.g. https://syncaitechnologies.com
NEXT_PUBLIC_SITE_URL=

# CASL compliance footer (legally required on outbound commercial email).
COMPANY_LEGAL_NAME=SyncAI Technologies
COMPANY_ADDRESS=

# Manager agent (LangGraph). Optional model override; defaults to OPENAI_MODEL.
OPENAI_AGENT_MODEL=
# Daily USD budget guard for all AI agents (default 5).
OPENAI_DAILY_BUDGET_USD=5

# Telegram (command the Manager + get notifications from your phone).
# Leave TELEGRAM_BOT_TOKEN blank to disable Telegram.
TELEGRAM_BOT_TOKEN=
# Your personal chat id — the ONLY chat the bot will talk to.
TELEGRAM_CHAT_ID=
# Random secret Telegram echoes back to prove a webhook call is genuine.
TELEGRAM_WEBHOOK_SECRET=

# Lead sourcing for the scraper agent. All optional — the scraper tries them in
# priority order (Apify → Places → Apollo) and uses the first that returns results.

# Apify — Google Maps scraping. Best free-ish way to get EMAILS if you use a
# contact-details actor (see APIFY_ACTOR_ID). Free tier includes ~$5/mo credits.
APIFY_TOKEN=
# Which Apify actor to run. Default (fast, no emails): compass~crawler-google-places
# For emails (slower — visits each website): lukaskrivka~google-maps-with-contact-details
APIFY_ACTOR_ID=

# Google Places API (New) — fast local-business search (company + phone, no email).
GOOGLE_PLACES_API_KEY=
# Apollo.io — company search on the free tier (no emails without a paid plan).
APOLLO_API_KEY=

# Set to "true" to let the research agent use OpenAI web search (else it
# generates a clearly-labelled knowledge-only brief).
RESEARCH_USE_WEB_SEARCH=

# Daily cron (nurture sequence ticks + CEO briefing). Any long random string.
# Vercel sends it as a Bearer token on the scheduled request; set the SAME value
# in Vercel so the cron authenticates. Also guards /api/cron/inbox (below).
CRON_SECRET=

# Gmail reply detection for the automation pipeline. Leave blank to keep replies
# manual (tell the Manager "the lead replied ..." via record_reply). When set,
# /api/cron/inbox polls the inbox for lead replies and advances the pipeline.
# Sign in as the inbox that receives replies (usually EMAIL_REPLY_TO).
# Create a "Desktop app" OAuth client in Google Cloud (Gmail API enabled), then
# run: GMAIL_CLIENT_ID=.. GMAIL_CLIENT_SECRET=.. node scripts/gmail-auth.mjs
# Register cron-job.org to GET https://www.syncai.tech/api/cron/inbox every 10 min
# with header "Authorization: Bearer <CRON_SECRET>".
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Stripe (pay-online invoices). Leave STRIPE_SECRET_KEY blank to keep invoicing
# in e-transfer-only mode (invoices still work, just emailed with e-transfer
# instructions instead of a Stripe pay link).
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint you create pointing at /api/stripe/webhook.
# Used to verify webhook signatures so only real Stripe events mark invoices paid.
STRIPE_WEBHOOK_SECRET=

# Voice calls (Phase 8) — the CEO/Manager triggers an outbound call to a lead
# and an external voice-agent provider places it. Leave blank to disable calling.
# Which provider to use: "retell" (default) or "vapi".
VOICE_PROVIDER=retell
# Shared secret appended to your provider webhook URL (?secret=...) so only the
# provider can post call results to /api/voice/webhook. Any long random string.
VOICE_WEBHOOK_SECRET=
# Retell (https://retellai.com): API key, the imported phone number to call FROM
# (E.164, e.g. +1416...), and the agent id to run.
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=
# Vapi (https://vapi.ai) — used instead if VOICE_PROVIDER=vapi.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
