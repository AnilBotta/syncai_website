# Supabase (leads + appointments persistence, admin dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=

# OpenAI (demo analyzer, chatbot, voice bot)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Cloudflare Turnstile (bot protection on the lead + booking forms).
# Leave both blank to disable verification (forms still work in dev/demo).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (outbound email from the admin Approval Inbox).
# Leave RESEND_API_KEY blank to keep email in demo mode (drafts queue, nothing sends).
RESEND_API_KEY=
# Must use a verified Resend domain, e.g. "Anil at SyncAI <anil@mail.syncaitechnologies.com>"
RESEND_FROM_EMAIL=
EMAIL_REPLY_TO=
# Random secret used to sign one-click unsubscribe links (any long random string).
UNSUBSCRIBE_SECRET=
# Public site URL, used to build unsubscribe links, e.g. https://syncaitechnologies.com
NEXT_PUBLIC_SITE_URL=

# CASL compliance footer (legally required on outbound commercial email).
COMPANY_LEGAL_NAME=SyncAI Technologies
COMPANY_ADDRESS=

# Manager agent (LangGraph). Optional model override; defaults to OPENAI_MODEL.
OPENAI_AGENT_MODEL=
# Daily USD budget guard for all AI agents (default 5).
OPENAI_DAILY_BUDGET_USD=5

# Telegram (command the Manager + get notifications from your phone).
# Leave TELEGRAM_BOT_TOKEN blank to disable Telegram.
TELEGRAM_BOT_TOKEN=
# Your personal chat id — the ONLY chat the bot will talk to.
TELEGRAM_CHAT_ID=
# Random secret Telegram echoes back to prove a webhook call is genuine.
TELEGRAM_WEBHOOK_SECRET=

# Lead sourcing for the scraper agent. All optional — the scraper tries them in
# priority order (Apify → Places → Apollo) and uses the first that returns results.

# Apify — Google Maps scraping. Best free-ish way to get EMAILS if you use a
# contact-details actor (see APIFY_ACTOR_ID). Free tier includes ~$5/mo credits.
APIFY_TOKEN=
# Which Apify actor to run. Default (fast, no emails): compass~crawler-google-places
# For emails (slower — visits each website): lukaskrivka~google-maps-with-contact-details
APIFY_ACTOR_ID=

# Google Places API (New) — fast local-business search (company + phone, no email).
GOOGLE_PLACES_API_KEY=
# Apollo.io — company search on the free tier (no emails without a paid plan).
APOLLO_API_KEY=

# Set to "true" to let the research agent use OpenAI web search (else it
# generates a clearly-labelled knowledge-only brief).
RESEARCH_USE_WEB_SEARCH=
